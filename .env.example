# ===== AlphaPipeline 환경설정 =====

# 결제를 수신할 Base 체인 지갑 주소 (0x로 시작하는 42자). x402 SDK 예제의
# X402_PAY_TO와 같은 역할 - 메타마스크 또는 코인베이스 월렛에서 Base
# 네트워크로 생성한 주소를 넣으세요. 실제 USDC가 여기로 정산됩니다.
RECEIVER_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# 호출당 요금 (달러 표기, USDC 1:1 가정. x402 SDK에 "$0.01"처럼 전달됨)
PRICE_PER_CALL_USDC=0.01

# ===== x402 공식 결제 레이어 (Coinbase CDP Facilitator) =====
# https://portal.cdp.coinbase.com 에서 프로젝트 생성 후 발급받는 API 키.
# 둘 다 채우면 실제 메인넷 USDC 결제를 검증/정산하는 CDP Facilitator를 씁니다.
# 비워두면 무료 테스트넷 파실리테이터(x402.org/facilitator)로 자동 대체되고,
# 이 경우 실제 메인넷 결제는 정산되지 않습니다 (개발/테스트 전용).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# CAIP-2 네트워크 식별자 (기본: Base 메인넷). CDP 키가 없으면 이 값과 무관하게
# 테스트넷(Base Sepolia, eip155:84532)으로 자동 전환됩니다.
X402_NETWORK=eip155:8453

# 이 서비스가 실제로 서빙되는 공개 절대 URL (프로토콜+도메인, 끝에 슬래시 없이).
# x402 Bazaar 인덱서가 각 라우트를 절대 URL로 식별해야 해서 필요합니다.
# 기본값이 이미 실제 Render 배포 주소로 되어 있어서, 도메인을 바꾸지 않는 한
# 그대로 두셔도 됩니다.
PUBLIC_BASE_URL=https://alphapipeline.onrender.com

# 김치프리미엄/시세 캐시 TTL(초) - 짧을수록 실시간에 가까움 (기본 2초)
KIMCHI_CACHE_TTL_SECONDS=2

# 락업 해제 전체 스캔 주기(시간) - 언락 일정은 미리 확정되므로 실시간일 필요 없음
# 기본 24(하루 1회)가 이미 충분히 낮은 빈도. 더 낮추고 싶으면 48, 72 등으로.
UNLOCK_REFRESH_INTERVAL_HOURS=24

# dump-risk 엔드포인트를 실제로 켤지 여부. DropsTab이 유료(월 $59~)라서, 일단 false로 두고
# kimchi-alert/ai-markdown 두 개만으로 먼저 출시해 수요를 검증한 뒤 켜는 전략.
# false인 동안은 이 엔드포인트가 결제 없이 503("coming_soon")만 반환함.
DUMP_RISK_ENABLED=false

# 락업 데이터 소스: DropsTab API 키 (DeFiLlama가 이 데이터를 유료화해서 교체함)
# Builders Program(무료, 승인제) 신청하거나 유료 Advanced 플랜(월 $59~, Basic $19에는 tokenUnlocks 미포함)에서 발급.
# DUMP_RISK_ENABLED=true로 바꿀 때 이 키도 채워야 실제 데이터가 나옴.
DROPSTAB_API_KEY=
DROPSTAB_API_BASE_URL=https://public-api.dropstab.com/api/v1

# 락업 스캔 시 한 페이지당 개수 / 최대 페이지 수 (과금·시간 보호용 상한)
DROPSTAB_PAGE_SIZE=100
MAX_UNLOCK_SCAN_PAGES=20

# 개발/테스트 중 x402 결제 미들웨어 자체를 장착하지 않고 싶으면 true로 바꾸세요.
# 기본값은 안전하게 false - 이 파일을 그대로 .env로 복사해도 결제 게이트가
# 살아있게 하기 위함(실서비스는 반드시 false, render.yaml도 이미 false).
PAYMENT_BYPASS_FOR_TESTING=false

# 서버 포트 (Render는 자동으로 PORT 환경변수를 주입함)
PORT=8000
